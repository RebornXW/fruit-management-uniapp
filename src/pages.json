{
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "水果档口管理",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/price/price",
			"style": {
				"navigationBarTitleText": "今日报价",
				"navigationBarBackgroundColor": "#0D9488",
				"navigationBarTextStyle": "white",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/inventory/inventory",
			"style": {
				"navigationBarTitleText": "库存管理",
				"navigationBarBackgroundColor": "#0D9488",
				"navigationBarTextStyle": "white",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/sales/sales",
			"style": {
				"navigationBarTitleText": "水果销售",
				"navigationBarBackgroundColor": "#0D9488",
				"navigationBarTextStyle": "white",
				"navigationStyle": "custom"
			}
		},
		{
			"path": "pages/profile/profile",
			"style": {
				"navigationBarTitleText": "个人中心",
				"navigationBarBackgroundColor": "#0D9488",
				"navigationBarTextStyle": "white",
				"navigationStyle": "custom"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "水果档口管理",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F5F5F5"
	},
	"tabBar": {
		"color": "#7A7E83",
		"selectedColor": "#0D9488",
		"backgroundColor": "#FFFFFF",
		"borderStyle": "black",
		"list": [
			{
				"pagePath": "pages/price/price",
				"text": "今日报价",
				"iconPath": "static/images/tabbar/price.png",
				"selectedIconPath": "static/images/tabbar/price-active.png",
				"iconClass": "fas fa-tag"
			},
			{
				"pagePath": "pages/inventory/inventory",
				"text": "库存管理",
				"iconPath": "static/images/tabbar/inventory.png",
				"selectedIconPath": "static/images/tabbar/inventory-active.png",
				"iconClass": "fas fa-warehouse"
			},
			{
				"pagePath": "pages/sales/sales",
				"text": "水果销售",
				"iconPath": "static/images/tabbar/sales.png",
				"selectedIconPath": "static/images/tabbar/sales-active.png",
				"iconClass": "fas fa-shopping-cart"
			},
			{
				"pagePath": "pages/profile/profile",
				"text": "个人中心",
				"iconPath": "static/images/tabbar/profile.png",
				"selectedIconPath": "static/images/tabbar/profile-active.png",
				"iconClass": "fas fa-user"
			}
		]
	},
	"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	}
}
