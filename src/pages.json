		"color": "#7A7E83",
		"selectedColor": "#0D9488",
		"borderStyle": "white",
		"backgroundColor": "#ffffff",
		"fontSize": "10px",
		"height": "50px",
		"list": [
			{
				"pagePath": "pages/price/price",
